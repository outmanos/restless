# Maintainer: Outman <23385633+outmanos@users.noreply.github.com>
pkgname=restless-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Offline-first API client for REST, GraphQL, gRPC, WebSockets and more'
arch=('x86_64')
url='https://github.com/outmanos/restless'
license=('Apache-2.0')
depends=('alsa-lib' 'curl' 'gtk3' 'libnotify' 'nss' 'xdg-utils')
provides=('restless')
conflicts=('restless')
options=('!strip')
source=("Restless-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/Restless-${pkgver}.tar.gz"
        "restless-${pkgver}.svg::https://raw.githubusercontent.com/outmanos/restless/v${pkgver}/packages/insomnia/src/icons/icon.svg")
sha256sums=('SKIP'
            'SKIP')

package() {
  install -d "${pkgdir}/opt/restless" "${pkgdir}/usr/bin"
  cp -a "Restless-${pkgver}/." "${pkgdir}/opt/restless/"
  ln -s /opt/restless/restless "${pkgdir}/usr/bin/restless"

  install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/restless.desktop" <<'EOF'
[Desktop Entry]
Name=Restless
Comment=The local-first API client
Exec=restless %U
Terminal=false
Type=Application
Icon=restless
Categories=Development;
MimeType=x-scheme-handler/restless;x-scheme-handler/insomnia;
Keywords=GraphQL;REST;gRPC;SOAP;openAPI;GitOps;
StartupWMClass=Restless
EOF
  install -Dm644 "restless-${pkgver}.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/restless.svg"
}
